# Configure clang-tidy for this project.
#
# The check set follows Google Cloud's C++ repository configuration, adapted
# for this C++20 project. Rationale for the disabled checks:
#
#  -bugprone-narrowing-conversions: too many false positives around
#      `std::size_t` vs. `*::difference_type`.
#
#  -bugprone-easily-swappable-parameters: too many false positives.
#
#  -bugprone-implicit-widening-of-multiplication-result: too many false
#      positives. Almost any expression of the form `2 * variable` or
#      `long x = a_int * b_int;` generates an error.
#
#  -bugprone-unchecked-optional-access: too many false positives in tests.
#      Despite what the documentation says, this warning appears after
#      `ASSERT_TRUE(variable.has_value())`.
#
#  -bugprone-exception-escape, -bugprone-inc-dec-in-conditions,
#  -bugprone-unused-local-non-trivial-variable, -bugprone-unused-return-value:
#      not applicable to this small codebase.
#
#  -google-readability-braces-around-statements,
#  -readability-braces-around-statements: single-line control flow reads fine
#      without braces.
#
#  -google-readability-namespace-comments: namespace comments are optional
#      here; clang-tidy also fails to match some macro-generated spellings.
#
#  -google-runtime-references: this codebase intentionally uses non-const
#      references for outputs.
#
#  -misc-non-private-member-variables-in-classes: our API structs hold plain
#      public members by design.
#
#  -misc-const-correctness, -misc-include-cleaner: too noisy / too many false
#      positives for this codebase.
#
#  -modernize-use-trailing-return-type: clang-tidy recommends using
#      `auto Foo() -> T { return ...; }`; we think the code is less readable in
#      this form (clang-tidy also cannot rewrite TEST-macro-generated functions).
#
#  -modernize-avoid-c-arrays: C arrays (`char foo[] = "hello"`) are the right
#      tool here; std::array does not deduce the size.
#
#  -performance-move-const-arg: This warning requires the developer to
#      know/care more about the implementation details of types/functions than
#      should be necessary.
#
#  -performance-avoid-endl: too many legitimate uses in the samples.
#
#  -performance-enum-size: smaller enums may or may not be faster; it depends
#      on the architecture.
#
#  -readability-identifier-length: short loop indices (i, j, k, d) are
#      idiomatic.
#
#  -readability-magic-numbers: numeric constants like 1e-12 and 2^-53 are
#      deliberate algorithm parameters.
#
#  -readability-named-parameter: stylistic, low value.
#
#  -readability-avoid-return-with-void-value: idiomatic and saves typing; the
#      intent is obvious.
#
#  -readability-function-cognitive-complexity: too many false positives.
Checks: >
  -*,
  abseil-*,
  bugprone-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -bugprone-inc-dec-in-conditions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-unchecked-optional-access,
  -bugprone-unused-local-non-trivial-variable,
  -bugprone-unused-return-value,
  -bugprone-throwing-static-initialization,
  -google-readability-braces-around-statements,
  -google-readability-namespace-comments,
  -google-runtime-references,
  -misc-non-private-member-variables-in-classes,
  -misc-const-correctness,
  -misc-use-anonymous-namespace,
  -misc-include-cleaner,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -performance-move-const-arg,
  -performance-avoid-endl,
  -performance-enum-size,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-avoid-return-with-void-value,
  -readability-function-cognitive-complexity,

# Turn all the warnings from the checks above into errors.
WarningsAsErrors: "*"

HeaderFilterRegex: "(^|/)(include/gsa|tests)/?.*\\.(h|hpp)$"
ExcludeHeaderFilterRegex: ".*XoshiroCpp\\.hpp"

CheckOptions:
  - { key: readability-identifier-naming.NamespaceCase,          value: lower_case }
  - { key: readability-identifier-naming.ClassCase,              value: CamelCase  }
  - { key: readability-identifier-naming.StructCase,             value: CamelCase  }
  - { key: readability-identifier-naming.TemplateParameterCase,  value: CamelCase  }
  - { key: readability-identifier-naming.FunctionCase,           value: aNy_CasE  }
  - { key: readability-identifier-naming.VariableCase,           value: lower_case }
  - { key: readability-identifier-naming.ClassMemberCase,        value: lower_case }
  - { key: readability-identifier-naming.ClassMemberSuffix,      value: _          }
  - { key: readability-identifier-naming.PrivateMemberSuffix,    value: _          }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,  value: _          }
  - { key: readability-identifier-naming.EnumConstantCase,         value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix,       value: k         }
  - { key: readability-identifier-naming.ConstexprVariableCase,    value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix,  value: k         }
  - { key: readability-identifier-naming.GlobalConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,     value: k         }
  - { key: readability-identifier-naming.MemberConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.MemberConstantPrefix,     value: k         }
  - { key: readability-identifier-naming.StaticConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,     value: k         }
  - { key: readability-implicit-bool-conversion.AllowIntegerConditions,  value: 1   }
  - { key: readability-implicit-bool-conversion.AllowPointerConditions,  value: 1   }
  - { key: readability-function-cognitive-complexity.IgnoreMacros,  value: 1       }
