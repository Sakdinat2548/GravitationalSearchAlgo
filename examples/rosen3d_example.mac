/* Rosenbrock 2D visualization example for Maxima.
   Run from the repository root, either batch:
     maxima -b examples/rosen3d_example.mac
   or interactively (Maxima / wxMaxima):
     batch("examples/rosen3d_example.mac")$

   Written against the Maxima 5.49 manual (plot3d / plot2d [contour] /
   [discrete] / numericalio). Adjust options to taste.
*/

/* ============================================================
   EDIT THIS IF YOU CHANGE objective.hpp (2D runs only)
   Mirror your 2D objective here (default: Rosenbrock,
   f(x, y) = 100*(y - x^2)^2 + (x - 1)^2, min at (1, 1)).
   For contour overlays also see the EDIT block in
   examples/gsa_plot.mac (objfn + gsa_obj_levels).
   ============================================================ */
objfn(x, y) := 100 * (y - x^2)^2 + (x - 1)^2$

load("numericalio")$

/* Bounds matching config.json defaults for the 2D Rosenbrock demo. */
lo : -2.048$
hi : 2.048$

/* 1. The "fn in 3D": surface z = f(x, y) with the banana valley. */
plot3d(objfn(x, y), [x, lo, hi], [y, lo, hi],
  [grid, 50, 50],
  [xlabel, "x"], [ylabel, "y"], [zlabel, "f"],
  [title, "Rosenbrock surface"])$

/* 2. Contour map (level sets of f). */
plot2d([contour, objfn(x, y)], [x, lo, hi], [y, lo, hi],
  [levels, 25], same_xy, [xlabel, "x"], [ylabel, "y"],
  [title, "Rosenbrock contours"])$

/* 2b. Same contours via draw (used for overlays/animation). Needs
   examples/gsa_plot.mac for gsa_obj_contours/gsa_obj_levels. */
/* batch("examples/gsa_plot.mac")$ */
/* draw2d(grid = true, title = "Rosenbrock contours",
  xlabel = "x", ylabel = "y",
  xrange = [lo, hi], yrange = [lo, hi],
  color = navy,
  gsa_obj_contours(lo, hi, gsa_obj_levels))$ */

/* 3. Overlay GSA agent positions from a snapshot export.
   Set SNAP to a snapshots.csv produced by the main demo
   (exports/run_<yyyymmdd_hhmmss>/snapshots.csv, rows: iter,agent,x1..xD)
   and K to the iteration to draw. Uses gsa_plot_contour from
   examples/gsa_plot.mac (draw-based, so contours stay thin). */
/* batch("examples/gsa_plot.mac")$ */
/* S : gsa_read_snapshots(SNAP)$ */
/* K : 0$ */
/* gsa_plot_contour(S, K, lo, hi)$ */

/* 4. Animated GIF: contour background + agents marching through all
   snapshot iterations. Needs the helpers in examples/gsa_plot.mac.
   Set ANIM to the output path (draw appends .gif to the file_name). */
/* batch("examples/gsa_plot.mac")$ */
/* S : gsa_read_snapshots(SNAP)$ */
/* ANIM : "exports/run_20260203_120000/anim"$ */
/* gsa_animate_contour(S, gsa_snapshot_iters(S), lo, hi, ANIM)$ */

/* 5. Everything to files at once (PNG stills + GIF) into the run folder:
   convergence.png, contour_first.png, contour_last.png, anim.gif. */
/* H : gsa_read_history("exports/run_20260203_120000/history.csv")$ */
/* gsa_export_all(S, H, gsa_snapshot_iters(S), lo, hi,
  "exports/run_20260203_120000")$ */
