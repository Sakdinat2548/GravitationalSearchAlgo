/* GSA plot helpers for Maxima.
   Run from the repository root, e.g.:
     load("numericalio")$
     batch("examples/gsa_plot.mac")$
   then:
     H : gsa_read_history("exports/run_20260203_120000/history.csv")$
     gsa_plot_convergence(H)$
     S : gsa_read_snapshots("exports/run_20260203_120000/snapshots.csv")$
     gsa_plot_snapshot(S, 0, 1, 2)$   (snapshot at iter 0, dims 1 and 2)
   or write everything to files at once:
     gsa_export_all(S, H, gsa_snapshot_iters(S), -2.048, 2.048,
       "exports/run_20260203_120000")$
   (convergence.png, contour_first.png, contour_last.png, anim.gif).
   Column layouts (no header rows, so read_matrix just works):
     history.csv   : best_so_far,best_iter,worst_iter,mean,median,stddev
     snapshots.csv : iter,agent,x1..xD
*/

load("numericalio")$

/* History matrix: one row per iteration (row 1 = iter 0). */
gsa_read_history(path) := read_matrix(path)$

/* Convergence curve: best_so_far vs iteration, log scale. */
gsa_plot_convergence(H) := plot2d(
  [discrete, makelist([i - 1, H[i][1]], i, 1, length(H))],
  [logy], [grid2d], [xlabel, "iteration"], [ylabel, "best_so_far"])$

/* Snapshot matrix: one row per (snapshot, agent). */
gsa_read_snapshots(path) := read_matrix(path)$

/* [x, y] points of snapshot taken at iteration K using dims XD and YD
   (1-based dimension indices). */
gsa_snapshot_points(S, k, xd, yd) := block([pts : []],
  for i thru length(S) do
    if S[i][1] = k then pts : cons([S[i][2 + xd], S[i][2 + yd]], pts),
  pts)$

/* Scatter of agents at iteration K. */
gsa_plot_snapshot(S, k, xd, yd) := plot2d(
  [discrete, gsa_snapshot_points(S, k, xd, yd)],
  [style, points], [grid2d],
  [xlabel, concat("x", xd)], [ylabel, concat("x", yd)],
  [title, concat("iter ", k)])$

/* Distinct iteration indices present in a snapshot matrix. */
gsa_snapshot_iters(S) := block([ks : []],
  for i thru length(S) do
    if not member(S[i][1], ks) then ks : cons(S[i][1], ks),
  sort(ks))$

/* ---- Contour + animation (2D Rosenbrock only) ----
   The contour needs the objective as a Maxima expression, so it assumes
   the default objective.hpp for dims = 2:
     rosen(x, y) = 100*(y - x^2)^2 + (x - 1)^2, min at (1, 1).
   If you edit objective.hpp, update rosen below to match.
*/

load("draw")$

rosen(x, y) := 100 * (y - x^2)^2 + (x - 1)^2$

/* Contour levels for Rosenbrock over typical [-2, 2]-ish bounds. */
gsa_rosen_levels : [0.5, 2, 10, 50, 200, 1000]$

/* Static contour map with snapshot-K agents overlaid (dims 1-2).
   Drawn with draw2d (per-object styles); plot2d's [contour] form cannot
   style contours and points independently. */
gsa_plot_contour(S, k, lo, hi) := apply('draw2d, append(
  [title = concat("iter ", k), grid = true,
   xlabel = "x1", ylabel = "x2",
   xrange = [lo, hi], yrange = [lo, hi],
   color = navy],
  gsa_rosen_contours(lo, hi, gsa_rosen_levels),
  [color = red, point_size = 2, point_type = filled_circle,
   key = "agents", points(gsa_snapshot_points(S, k, 1, 2))]))$

/* Contour curves as draw objects (shared background for every frame). */
gsa_rosen_contours(lo, hi, levels) := makelist(
  implicit(rosen(x, y) = c, x, lo, hi, y, lo, hi), c, levels)$

/* Animated GIF: static contours + agents at each iter in KS.
   KS is a list, e.g. gsa_snapshot_iters(S). OUTFILE gets .gif appended
   by draw; DELAY is in 1/100 s per frame. */
gsa_animate_contour(S, ks, lo, hi, outfile) := block(
  [contours : gsa_rosen_contours(lo, hi, gsa_rosen_levels), frames],
  frames : makelist(
    apply('gr2d, append([title = concat("iter ", k),
                         xrange = [lo, hi], yrange = [lo, hi]],
                        contours,
                        [points(gsa_snapshot_points(S, k, 1, 2))])),
    k, ks),
  apply('draw, append([delay = 20, file_name = outfile,
                       terminal = 'animated_gif, dimensions = [600, 500]],
                      frames)))$

/* ---- File export: PNG stills + animated GIF ----
   Screen-plot mirrors that write to files instead. plot2d plots use
   [gnuplot_term, png] + [gnuplot_out_file, ...] ([png_file, ...] hits
   an unbound-GNUPLOT-PREAMBLE Lisp error on Maxima 5.49/Windows, which
   Maxima silently skips past). For draw2d plots PATH is the file_name
   basename (draw appends .png).
*/

/* Convergence curve → PNG. */
gsa_save_convergence(H, path) := plot2d(
  [discrete, makelist([i - 1, H[i][1]], i, 1, length(H))],
  [logy], [grid2d], [xlabel, "iteration"], [ylabel, "best_so_far"],
  [gnuplot_term, png], [gnuplot_out_file, path])$

/* Agent scatter at iter K → PNG. */
gsa_save_snapshot(S, k, xd, yd, path) := plot2d(
  [discrete, gsa_snapshot_points(S, k, xd, yd)],
  [style, points], [grid2d],
  [xlabel, concat("x", xd)], [ylabel, concat("x", yd)],
  [title, concat("iter ", k)],
  [gnuplot_term, png], [gnuplot_out_file, path])$

/* Contour + agents at iter K → PNG (draw-based, thin contours). */
gsa_save_contour(S, k, lo, hi, path) := apply('draw2d, append(
  [terminal = 'png, file_name = path,
   title = concat("iter ", k), grid = true,
   xlabel = "x1", ylabel = "x2",
   xrange = [lo, hi], yrange = [lo, hi],
   color = navy],
  gsa_rosen_contours(lo, hi, gsa_rosen_levels),
  [color = red, point_size = 2, point_type = filled_circle,
   key = "agents", points(gsa_snapshot_points(S, k, 1, 2))]))$

/* Everything at once: convergence.png, contour_first.png,
   contour_last.png and anim.gif into DIR (caller creates it).
   KS lists the snapshot iters; LO/HI are the 2D bounds. */
gsa_export_all(S, H, ks, lo, hi, dir) := block(
  [first_k : first(ks), last_k : last(ks)],
  gsa_save_convergence(H, concat(dir, "/convergence.png")),
  gsa_save_contour(S, first_k, lo, hi, concat(dir, "/contour_first")),
  gsa_save_contour(S, last_k, lo, hi, concat(dir, "/contour_last")),
  gsa_animate_contour(S, ks, lo, hi, concat(dir, "/anim")))$
